!pip install -q streamlit scikit-learn pandas numpy joblib kagglehub

import os
import glob
import kagglehub
import pandas as pd
import numpy as np
import joblib

from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix
)

# ==========================================
# 1. DOWNLOAD DATASET
# ==========================================

print("Downloading Kaggle weather dataset...")

dataset_path = kagglehub.dataset_download(
    "ananthr1/weather-prediction"
)

print("Dataset downloaded to:", dataset_path)

# Find CSV files
csv_files = glob.glob(
    os.path.join(dataset_path, "**", "*.csv"),
    recursive=True
)

if not csv_files:
    raise FileNotFoundError("No CSV file found in the dataset.")

print("Available CSV files:", csv_files)

# Read the dataset
df = pd.read_csv(csv_files[0])

# Normalize column names
df.columns = df.columns.str.strip().str.lower()

print("\nDataset Preview:")
display(df.head())

print("\nDataset Columns:")
print(df.columns.tolist())

# ==========================================
# 2. DATA CLEANING
# ==========================================

features = [
    "precipitation",
    "temp_max",
    "temp_min",
    "wind"
]

target = "weather"

required_columns = features + [target]

missing_columns = [
    col for col in required_columns
    if col not in df.columns
]

if missing_columns:
    raise ValueError(
        f"Missing expected columns: {missing_columns}"
    )

# Convert numerical columns
for col in features:
    df[col] = pd.to_numeric(
        df[col], errors="coerce"
    )

# Remove rows with missing values
df = df.dropna(subset=required_columns)

# Normalize weather labels
df[target] = df[target].astype(str).str.strip().str.lower()

# Remove invalid target values
df = df[df[target].isin([
    "sun", "rain", "snow", "fog", "drizzle"
])]

print("\nCleaned dataset shape:", df.shape)

print("\nWeather Distribution:")
print(df[target].value_counts())

# ==========================================
# 3. CONVERT NUMERICAL FEATURES TO YES/NO
# ==========================================

# Calculate median thresholds from training data
X_train_raw, X_test_raw, y_train, y_test = train_test_split(
    df[features],
    df[target],
    test_size=0.20,
    random_state=42,
    stratify=df[target]
)

thresholds = X_train_raw.median().to_dict()

def convert_to_binary(data):
    result = pd.DataFrame(index=data.index)

    for feature in features:
        result[feature] = (
            data[feature] > thresholds[feature]
        ).astype(int)

    return result

X_train = convert_to_binary(X_train_raw)
X_test = convert_to_binary(X_test_raw)

print("\nYES/NO Thresholds:")
for feature, value in thresholds.items():
    print(f"{feature}: {value:.3f}")

# ==========================================
# 4. TRAIN RANDOM FOREST MODEL
# ==========================================

model = RandomForestClassifier(
    n_estimators=300,
    max_depth=12,
    min_samples_split=4,
    min_samples_leaf=2,
    class_weight="balanced",
    random_state=42
)

print("\nTraining Random Forest Model...")

model.fit(X_train, y_train)

# ==========================================
# 5. EVALUATE MODEL
# ==========================================

predictions = model.predict(X_test)

accuracy = accuracy_score(y_test, predictions)

print("\n================================")
print("MODEL EVALUATION")
print("================================")

print(f"Model Accuracy: {accuracy * 100:.2f}%")

print("\nClassification Report:")
print(classification_report(
    y_test,
    predictions,
    zero_division=0
))

print("\nConfusion Matrix:")
print(confusion_matrix(
    y_test,
    predictions,
    labels=model.classes_
))

# ==========================================
# 6. SAVE MODEL
# ==========================================

model_package = {
    "model": model,
    "thresholds": thresholds,
    "features": features,
    "classes": model.classes_.tolist()
}

joblib.dump(model_package, "model.pkl")

print("\n================================")
print("MODEL SAVED SUCCESSFULLY!")
print("File: model.pkl")
print("================================")
